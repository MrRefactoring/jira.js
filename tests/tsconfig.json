{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "paths": {
      "@jirajs": ["../src"],
      "@jirajs/*": ["../src/*"],
      "@tests": ["./"],
      "@tests/*": ["./*"],
      "#/*": ["../src/*"]
    }
  },
  "include": ["unit", "live"]
}