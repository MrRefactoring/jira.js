HOST=
EMAIL=
API_TOKEN=

# Optional. Resolved from HOST when left empty; set it only to override that.
JIRA_ORG_ID=

# Optional. An organization API key from admin.atlassian.com -> Settings -> API keys, for the administration suites.
# A site API token does not substitute: those APIs answer 401 to one. Absent, those suites stand down.
JIRA_ADMIN_API_KEY=
